# TradeX Environment Variables

# Google Gemini API Key (Required)
# Get your free key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model (Optional - defaults to gemini-3.5-flash-lite)
# Options: gemini-3.5-flash-lite, gemini-flash-latest, gemini-3.8-flash
GEMINI_MODEL=gemini-3.5-flash-lite

# Server Port (Optional - defaults to 3001)
PORT=3001

# CORS Origin (Optional - defaults to http://localhost:5173)
CORS_ORIGIN=http://localhost:5173

# Node Environment
NODE_ENV=development
